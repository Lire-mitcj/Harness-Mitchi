# ==============================================================================
# MitKII Configuration File Template
# Copy this file to '.env' in your project root or current working directory:
#   cp .env.example .env
# ==============================================================================

# --- LLM API Keys (At least one is required) ----------------------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.siliconflow.cn/v1

# --- Model Configurations -----------------------------------------------------
MITKII_MODEL=openai/deepseek-ai/DeepSeek-V4-Flash
MITKII_CURSOR_INTER_MODEL=openai/Qwen/Qwen2.5-7B-Instruct
MITKII_CURSOR_SUMMARIZER_MODEL=openai/Qwen/Qwen2.5-32B-Instruct
MITKII_CURSOR_QUERY_BRIDGE_MODEL=openai/Qwen/Qwen2.5-32B-Instruct
MITKII_CURSOR_DECISION_MODEL=openai/deepseek-ai/DeepSeek-V4-Flash
MITKII_CURSOR_VALIDATOR_MODEL=none

# --- Embedding & Reranker Configurations --------------------------------------
MITKII_EMBEDDING_MODEL=openai/BAAI/bge-m3
# MITKII_EMBEDDING_PROVIDER=ollama   # Optional: set to 'ollama' for local runs

MITKII_CURSOR_RERANKER_ENABLED=true
MITKII_CURSOR_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MITKII_CURSOR_RERANKER_TOP_N=50
MITKII_CURSOR_RERANKER_TIMEOUT=10.0

# --- Advanced Settings (Optional) ---------------------------------------------
# MITKII_MODE=assembled              # 'assembled' or 'discrete'
# MITKII_MAX_CONTEXT_TOKENS=128000
# MITKII_SCOUT_ENABLED=false
# MITKII_REPO_MAP_ENABLED=true
